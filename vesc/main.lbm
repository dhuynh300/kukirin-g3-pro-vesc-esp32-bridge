;; main.lbm: powertrain script for the rear VESC (CAN ID 26), VESC firmware 7.00.
;;
;; The ESP32 sends control frames over UART (throttle, brake, dual drive, speed limit). This script turns
;; them into current commands for the rear motor and, over CAN, the front VESC (CAN ID 123), and sends
;; speed and fault telemetry back. Two threads:
;;   thd-powertrain-50hz  every 20 ms: killswitch, faults, UART frames, dead-man, drive/brake, telemetry
;;   thd-can-supervisor   every 100 ms: marks the front VESC offline after 500 ms without CAN status
;;
;; Rules for editing this file:
;;   - Never use set-handbrake: it pushes holding current at standstill and heats the motor coils.
;;     Braking uses passive current braking (set-brake-rel / canset-brake-rel).
;;   - Never use foc-beep: it stops the motor, reconfigures FOC and sleeps the interpreter for the whole
;;     beep (mcpwm_foc_beep in the VESC source), which halts every thread in this script. Use foc-play-tone.
;;   - Never call canset-current with an off-delay: VESC 7.00 decodes those CAN fields in the wrong order
;;     (a 1.0 s off-delay arrives as 1.0 A). Use canset-current-rel with the off-delay instead.
;;   - Allocate buffers once with bufcreate at load time; allocation inside the loops causes GC pauses.
;;   - Integer and float math differ: convert with to-float before dividing when a fraction is needed.
;;   - Constants also defined in the ESP32 code are checked by tools/check_shared_constants.py.

;; Link settings
(def CAN-ID-REAR-VESC  26)     ; this VESC
(def CAN-ID-FRONT-VESC 123)    ; front VESC, commanded over CAN
(def VESC-UART-BAUD    230400) ; must match the ESP32

(uart-start VESC-UART-BAUD)

(puts "V:Init:230.4k:26+123")

;; Version (the ESP32 version is filled in from its log messages)
(def SCRIPT-VERSION "v1.0.0")
(def SCRIPT-BUILD   "2026-10-01 17:15")
(def esp-fw-version "unknown")
(def esp-build-time "unknown")

;; (ver) in the VESC Tool terminal prints both versions
(defun ver ()
    {
        (puts (str-merge "VESC LispBM: " SCRIPT-VERSION " (" SCRIPT-BUILD ")"))
        (puts (str-merge "ESP32 Bridge: " esp-fw-version " (" esp-build-time ")"))
    }
)

;; UART frame: START-1 START-2 type length payload CRC16 (same format as the ESP32 side)
(def START-1 170) ; 0xAA
(def START-2 85)  ; 0x55
(def MSG-HEARTBEAT 0)
(def MSG-CONTROL   1)
(def MSG-AUDIO     2)
(def MSG-TELEM     3)
(def MSG-DEBUG-LOG 6)


;; Vehicle (wheel size and poles are documentation here; speeds come from the VESC Tool settings)
(def WHEEL-DIAMETER-INCHES 10.0)
(def MOTOR-POLE-PAIRS 15)
(def SPEED-STATIONARY-MPH 0.6)
(def SPEED-STATIONARY-MPS (* SPEED-STATIONARY-MPH 0.44704)) ; 0.268224 m/s
(def SPEED-STATIONARY-ERPM 300) ; about 0.6 mph with a 10 in wheel and 15 pole pairs
(def SPEED-STANDSTILL-MPS SPEED-STATIONARY-MPS)

;; Throttle and brake commands are 0..10000 counts = 0..100 % of the motor current limit in VESC Tool
(def THROTTLE-SCALE-MAX 10000)
(def THROTTLE-NEUTRAL-COUNTS 100) ; below 1 %: freewheel, and the level needed to arm

;; Regen fades in per wheel between these speeds; below the lower one there is no regen
(def SPEED-REGEN-MIN-MPS 2.235) ; 5.0 mph, set from ride testing
(def SPEED-REGEN-MAX-MPS 8.941) ; 20.0 mph, full PB level above this
(def REGEN-LERP-RANGE-MPS (- SPEED-REGEN-MAX-MPS SPEED-REGEN-MIN-MPS)) ; 6.706 m/s
(def INV-REGEN-RANGE (/ 1.0 REGEN-LERP-RANGE-MPS)) ; multiply instead of divide in the loop

(def SPEED-ROLL-THRESH-ERPM 500) ; about 1 mph: above this a wheel counts as rolling
(def COAST-OFF-DELAY-SEC    1.0) ; keep modulating for 1 s after current goes to 0, so throttle re-engages smoothly
(def SPEED-LIMIT-TAPER-MPS  1.341) ; 3.0 mph: drive fades to 0 over this window below the limit

;; Buffers, allocated once
(def rx-header (bufcreate 2))     ; start bytes
(def rx-frame (bufcreate 135))    ; type, length, payload
(def rx-crc (bufcreate 2))        ; received CRC
(def tx-payload (bufcreate 5))    ; telemetry: type, length, speed (2 bytes, little-endian), fault flags
(def tx-telem (bufcreate 9))      ; whole telemetry frame
(def log-str-buf (bufcreate 125)) ; ESP32 log lines are at most 120 bytes

(bufset-u8 tx-telem 0 START-1)
(bufset-u8 tx-telem 1 START-2)
(bufset-u8 tx-payload 0 MSG-TELEM)
(bufset-u8 tx-payload 1 3)
(bufset-u8 tx-payload 4 0) ; fault flags: bit 0 front VESC lost, bits 1-7 this VESC's fault code

;; State
(def boot-locked t)            ; unarmed: motors off until arming (see the control frame handler)
(def conf-max-current 120.0)   ; read from the motor config when arming; not used otherwise
(def conf-min-current -120.0)  ; same
(def last-rx-time (systime))
(def missed-ticks 0)
(def drop-dbg-verbose nil)     ; t: log single missing frames, nil: only two or more (set from the ESP32 console)
(def front-vesc-online t)
(def current-rear-cmd 0.0)
(def current-front-cmd 0.0)

(def target-throt 0)           ; last throttle from the ESP32
(def actual-throt 0)           ; throttle applied
(def target-brake 0)           ; last brake from the ESP32
(def actual-brake 0)           ; brake applied
(def active-dual-mode 1)       ; 1 both motors, 0 rear only
(def active-speed-limit 0)     ; cm/s, 0 = no limit

;; Hill hold: after 1 s stopped with the brake held, brake at the full PB level until the brake is released
(def standstill-start-time 0)
(def stop-assist-active    nil)

;; Logged only on change
(def last-log-throt -1)
(def last-log-brake -1)
(def last-log-dual -1)
(def last-log-state -1)        ; 0=IDLE, 1=DRV, 2=BRK, 3=KILL, 4=LOCK, 5=CUT
(def last-fault-code 0)
(def last-log-clamped nil)

@const-start

;; Log a VESC fault code by name
(defun log-fault (code)
    (if (= code 1) (puts "V:Fault:OverV:E2")
    (if (= code 2) (puts "V:Fault:UnderV:E2")
    (if (= code 3) (puts "V:Fault:Drv:E2")
    (if (= code 4) (puts "V:Fault:AbsOc:E2")
    (if (= code 5) (puts "V:Fault:OtFet:E2")
    (if (= code 6) (puts "V:Fault:OtMot:E2")
    (if (= code 18) (puts "V:Fault:UnbalI:E2")
    (puts "V:Fault:Generic:E2"))))))))
)

;; Arming chime through the motor coils (D5, F#5, A5, D6). Runs in its own thread so the sleeps do not
;; stall control; each tone is skipped if the vehicle was disarmed meanwhile.
(defun play-drone-startup ()
    {
        (if (not boot-locked) (foc-play-tone 0 587.33 2.5))
        (sleep 0.08)

        (if (not boot-locked) (foc-play-tone 0 739.99 3.0))
        (sleep 0.08)

        (if (not boot-locked) (foc-play-tone 0 880.00 3.5))
        (sleep 0.08)

        (sleep 0.05)

        (if (not boot-locked) (foc-play-tone 0 1174.66 4.0))
        (sleep 0.25)
        (foc-play-stop)
    }
)

;; Zero current on both motors and clear all targets. Called only from the powertrain thread.
(defun cut-motors ()
    {
        (set-current 0.0)
        (if front-vesc-online
            (canset-current CAN-ID-FRONT-VESC 0.0)
        )
        (setq current-rear-cmd 0.0)
        (setq current-front-cmd 0.0)
        (setq target-throt 0)
        (setq actual-throt 0)
        (setq target-brake 0)
        (setq actual-brake 0)
        (setq stop-assist-active nil)
        (setq standstill-start-time 0)
    }
)

;; Powertrain thread, every 20 ms
(defun thd-powertrain-50hz ()
    (loopwhile t
        {
            (var t-start (systime))

            ;; Killswitch: the ESP32 holds ADC2 low (below 1.65 V) until brake-to-start. Low, a cut wire
            ;; or a failed reading all mean motors off.
            (var adc-val (get-adc 1))
            (var kill-pin-low (if adc-val (< adc-val 1.65) t))
            (if kill-pin-low
                (if (not boot-locked)
                    {
                        (setq boot-locked t)
                        (cut-motors)
                        (foc-play-stop)
                        (if (!= last-log-state 3)
                            {
                                (setq last-log-state 3)
                                (puts "V:Kill:0V:E2")
                            }
                        )
                    }
                )
            )

            ;; This VESC's fault code (sent to the ESP32 in telemetry)
            (var live-fault (get-fault))
            (if (!= live-fault last-fault-code)
                {
                    (setq last-fault-code live-fault)
                    (if (> live-fault 0)
                        (log-fault live-fault)
                        (puts "V:FaultCleared:E2")
                    )
                }
            )

            ;; Read UART frames: up to 11 per pass, so a backlog is drained and the newest control frame wins
            (var keep-reading t)
            (var has-read nil)
            (var drain-count 0)
            (loopwhile keep-reading
                {
                    (var read-byte (uart-read rx-header 1 0 nil 0))
                    (if (> read-byte 0)
                        (if (= (bufget-u8 rx-header 0) START-1)
                            {
                                (var read-b2 (uart-read rx-header 1 1 nil 0))
                                (if (= read-b2 0)
                                    {
                                        (yield 500)
                                        (setq read-b2 (uart-read rx-header 1 1 nil 0))
                                    }
                                )
                                ;; 0xAA 0xAA 0x55: skip the extra 0xAA
                                (if (and (> read-b2 0) (= (bufget-u8 rx-header 1) START-1))
                                    (setq read-b2 (uart-read rx-header 1 1 nil 0))
                                )
                                (if (and (> read-b2 0) (= (bufget-u8 rx-header 1) START-2))
                                    {
                                        (var read-meta (uart-read rx-frame 2 0 nil 0))
                                        (if (< read-meta 2)
                                            {
                                                (yield 500)
                                                (setq read-meta (+ read-meta (uart-read rx-frame (- 2 read-meta) read-meta nil 0)))
                                            }
                                        )
                                        (if (= read-meta 2)
                                            {
                                                (var msg-type (bufget-u8 rx-frame 0))
                                                (var msg-len  (bufget-u8 rx-frame 1))

                                                ;; Payload of at most 120 bytes
                                                (var read-p 0)
                                                (var read-c 0)
                                                (if (and (> msg-len 0) (<= msg-len 120))
                                                    {
                                                        (setq read-p (uart-read rx-frame msg-len 2 nil 0))
                                                        (if (< read-p msg-len)
                                                            {
                                                                (yield 1000)
                                                                (setq read-p (+ read-p (uart-read rx-frame (- msg-len read-p) (+ 2 read-p) nil 0)))
                                                            }
                                                        )
                                                        (setq read-c (uart-read rx-crc 2 0 nil 0))
                                                        (if (< read-c 2)
                                                            {
                                                                (yield 500)
                                                                (setq read-c (+ read-c (uart-read rx-crc (- 2 read-c) read-c nil 0)))
                                                            }
                                                        )
                                                    }
                                                    (if (= msg-len 0)
                                                        {
                                                            (setq read-p 0)
                                                            (setq read-c (uart-read rx-crc 2 0 nil 0))
                                                            (if (< read-c 2)
                                                                {
                                                                    (yield 500)
                                                                    (setq read-c (+ read-c (uart-read rx-crc (- 2 read-c) read-c nil 0)))
                                                                }
                                                            )
                                                        }
                                                        {
                                                            ;; Bad length: drop one byte and search again
                                                            (uart-read rx-header 1 0 nil 0)
                                                        }
                                                    )
                                                )

                                                (if (and (= read-p msg-len) (= read-c 2))
                                                    {
                                                        (var exp-crc (crc16 rx-frame (+ 2 msg-len)))
                                                        (var got-crc (bufget-u16 rx-crc 0))

                                                        (if (= exp-crc got-crc)
                                                            {
                                                                ;; Any valid frame feeds the dead-man timer
                                                                (setq last-rx-time (systime))
                                                                (setq missed-ticks 0)
                                                                (setq has-read t)

                                                                (if (= msg-type MSG-CONTROL)
                                                                    {
                                                                        (var raw-throt (bufget-u16 rx-frame 2 'little-endian))
                                                                        (var raw-brake (bufget-u16 rx-frame 4 'little-endian))
                                                                        (var dual-mode (bufget-u8  rx-frame 6))
                                                                        (var spd-limit (if (>= msg-len 7) (bufget-u16 rx-frame 7 'little-endian) 0))

                                                                        (var clamped-throt (if (> raw-throt THROTTLE-SCALE-MAX) THROTTLE-SCALE-MAX (if (< raw-throt 0) 0 raw-throt)))
                                                                        (setq target-throt clamped-throt)
                                                                        (setq target-brake raw-brake)
                                                                        (setq active-dual-mode dual-mode)
                                                                        (setq active-speed-limit spd-limit)

                                                                        (if (!= dual-mode last-log-dual)
                                                                            {
                                                                                (setq last-log-dual dual-mode)
                                                                                (if (= dual-mode 1)
                                                                                    (puts "V:Mode:Dual")
                                                                                    (puts "V:Mode:1WD")
                                                                                )
                                                                            }
                                                                        )

                                                                        (if kill-pin-low
                                                                            {
                                                                                (setq boot-locked t)
                                                                                (cut-motors)
                                                                            }
                                                                            {
                                                                                ;; Arm when the killswitch is high, the throttle is released and the rear wheel
                                                                                ;; is stopped. Brake-to-start itself is checked on the ESP32, which keeps the
                                                                                ;; killswitch low until then.
                                                                                (if boot-locked
                                                                                    {
                                                                                        (var rear-rpm-live (get-rpm))
                                                                                        (var rear-erpm-abs (if rear-rpm-live (abs (to-float rear-rpm-live)) 0.0))
                                                                                        (if (and (<= raw-throt THROTTLE-NEUTRAL-COUNTS) (< rear-erpm-abs SPEED-STATIONARY-ERPM))
                                                                                            {
                                                                                                (setq boot-locked nil)
                                                                                                (var c-max (conf-get 'l-current-max))
                                                                                                (if c-max (setq conf-max-current c-max))
                                                                                                (var c-min (conf-get 'l-current-min))
                                                                                                (if c-min (setq conf-min-current c-min))
                                                                                                (spawn play-drone-startup)
                                                                                                (setq last-log-state 0)
                                                                                                (puts "V:Armed")
                                                                                            }
                                                                                            (cut-motors)
                                                                                        )
                                                                                    }
                                                                                )
                                                                            }
                                                                        )
                                                                    }
                                                                )

                                                                ;; Log line from the ESP32: print it to the VESC Tool terminal
                                                                (if (= msg-type MSG-DEBUG-LOG)
                                                                    {
                                                                        (var copy-len (if (> msg-len 120) 120 msg-len))
                                                                        (bufcpy log-str-buf 0 rx-frame 2 copy-len)
                                                                        (if (> copy-len 0)
                                                                            {
                                                                                (var has-nl (= (bufget-u8 log-str-buf (- copy-len 1)) 10))
                                                                                (if (not has-nl)
                                                                                    {
                                                                                        (bufset-u8 log-str-buf copy-len 10)
                                                                                        (setq copy-len (+ copy-len 1))
                                                                                    }
                                                                                )
                                                                            }
                                                                        )
                                                                        (bufset-u8 log-str-buf copy-len 0)
                                                                        (puts log-str-buf)

                                                                        (var idx-drop (str-find log-str-buf "E:DropDbg:"))
                                                                        (if (>= idx-drop 0)
                                                                            {
                                                                                (var mode-char (bufget-u8 log-str-buf (+ idx-drop 10)))
                                                                                (setq drop-dbg-verbose (= mode-char 49)) ; '1'
                                                                            }
                                                                        )

                                                                        ;; Store the ESP32 version for (ver). These string functions allocate; acceptable
                                                                        ;; because version lines are rare, but they should move out of this loop.
                                                                        (var idx-ver (str-find log-str-buf "E:Ver:"))
                                                                        (if (>= idx-ver 0)
                                                                            {
                                                                                (var rem (str-part log-str-buf (+ idx-ver 6)))
                                                                                (setq esp-fw-version (car (str-split rem "\n\r")))
                                                                            }
                                                                            {
                                                                                (var idx-leg (str-find log-str-buf "Esp32:Version:"))
                                                                                (if (>= idx-leg 0)
                                                                                    {
                                                                                        (var rem (str-part log-str-buf (+ idx-leg 14)))
                                                                                        (var idx-bld (str-find rem ":Build:"))
                                                                                        (if (>= idx-bld 0)
                                                                                            {
                                                                                                (setq esp-fw-version (str-part rem 0 idx-bld))
                                                                                                (setq esp-build-time (car (str-split (str-part rem (+ idx-bld 7)) "\n\r")))
                                                                                            }
                                                                                            {
                                                                                                (setq esp-fw-version (car (str-split rem "\n\r")))
                                                                                            }
                                                                                        )
                                                                                    }
                                                                                    {
                                                                                        (var idx-fw (str-find log-str-buf "Esp32:Fw:"))
                                                                                        (if (>= idx-fw 0)
                                                                                            {
                                                                                                (var clean-line (car (str-split (str-part log-str-buf (+ idx-fw 9)) "\n\r")))
                                                                                                (var first-col (str-find clean-line ":"))
                                                                                                (if (>= first-col 0)
                                                                                                    {
                                                                                                        (setq esp-fw-version (str-part clean-line 0 first-col))
                                                                                                        (setq esp-build-time (str-part clean-line (+ first-col 1)))
                                                                                                    }
                                                                                                    (setq esp-fw-version clean-line)
                                                                                                )
                                                                                            }
                                                                                        )
                                                                                    }
                                                                                )
                                                                            }
                                                                        )
                                                                    }
                                                                )
                                                            }
                                                            {
                                                                ;; Bad CRC: drop one byte and search again
                                                                (uart-read rx-header 1 0 nil 0)
                                                            }
                                                        )
                                                    }
                                                    {
                                                        ;; Incomplete frame: drop one byte and search again
                                                        (uart-read rx-header 1 0 nil 0)
                                                    }
                                                )
                                            }
                                        )
                                    }
                                )
                            }
                            {
                                ;; Not a start byte: stop if a frame was already read this pass
                                (if has-read
                                    (setq keep-reading nil)
                                )
                            }
                        )
                        {
                            (setq keep-reading nil)
                        }
                    )
                    (setq drain-count (+ drain-count 1))
                    (if (> drain-count 10)
                        (setq keep-reading nil)
                    )
                }
            )

            ;; Motor commands
            (if (or boot-locked kill-pin-low (> live-fault 0))
                {
                    (cut-motors)
                }
                {
                    ;; Dead-man: no valid frame for 500 ms cuts the motors (the VESC Tool timeout is also 500 ms)
                    (var delta-rx (secs-since last-rx-time))
                    (if (>= delta-rx 0.500)
                        {
                            (cut-motors)
                            (foc-play-stop)
                            (if (!= last-log-state 5)
                                {
                                    (setq last-log-state 5)
                                    (puts "V:DeadmanCut:E3")
                                }
                            )
                        }
                        ;; Under 500 ms: keep using the last throttle, brake and mode
                        {
                            ;; Log missing frames (one or more in verbose mode, two or more otherwise)
                            (if (> delta-rx 0.025)
                                {
                                    (var cur-missed-ticks (to-i (floor (/ (- delta-rx 0.005) 0.020))))
                                    (var min-report-ticks (if drop-dbg-verbose 1 2))
                                    (if (and (>= cur-missed-ticks min-report-ticks) (> cur-missed-ticks missed-ticks))
                                        {
                                            (setq missed-ticks cur-missed-ticks)
                                            (if (= missed-ticks 1) (puts "V:EspDrop:1:E3")
                                            (if (= missed-ticks 2) (puts "V:EspDrop:2:E3")
                                            (if (= missed-ticks 3) (puts "V:EspDrop:3:E3")
                                            (if (= missed-ticks 4) (puts "V:EspDrop:4:E3")
                                            (puts "V:EspDrop:Streak:E3")))))
                                        }
                                    )
                                }
                            )

                            ;; Brake wins over throttle
                            (if (> target-brake 0)
                                {
                                    (setq actual-throt 0)
                                    (setq target-throt 0)
                                    (setq actual-brake target-brake)
                                    (var brake-ratio (/ (to-float actual-brake) 10000.0))
                                    (var rear-spd-val (get-speed))
                                    (var rear-spd-mps (if rear-spd-val (abs (to-float rear-spd-val)) 0.0))
                                    (var front-spd-val (if front-vesc-online (canget-speed CAN-ID-FRONT-VESC) 0.0))
                                    (var front-spd-mps (if front-spd-val (abs (to-float front-spd-val)) 0.0))

                                    ;; Hill hold after 1 s stopped on the brake (both wheels)
                                    (var is-standstill (and (< rear-spd-mps SPEED-STANDSTILL-MPS) (< front-spd-mps SPEED-STANDSTILL-MPS)))
                                    (if is-standstill
                                        {
                                            (if (= standstill-start-time 0)
                                                (setq standstill-start-time (systime))
                                            )
                                            (if (and (not stop-assist-active) (> (secs-since standstill-start-time) 1.0))
                                                (setq stop-assist-active t)
                                            )
                                        }
                                        {
                                            (if (not stop-assist-active)
                                                (setq standstill-start-time 0)
                                            )
                                        }
                                    )

                                    ;; Regen per wheel: 0 below 5 mph, rising to full at 20 mph (full at any speed during hill hold)
                                    (var effective-brake-rear brake-ratio)
                                    (if (not stop-assist-active)
                                        {
                                            (var rear-scale 0.0)
                                            (if (>= rear-spd-mps SPEED-REGEN-MAX-MPS)
                                                (setq rear-scale 1.0)
                                                (if (> rear-spd-mps SPEED-REGEN-MIN-MPS)
                                                    (setq rear-scale (* (- rear-spd-mps SPEED-REGEN-MIN-MPS) INV-REGEN-RANGE))
                                                    (setq rear-scale 0.0)
                                                )
                                            )
                                            (setq effective-brake-rear (* brake-ratio rear-scale))
                                        }
                                    )

                                    (var effective-brake-front brake-ratio)
                                    (if (not stop-assist-active)
                                        {
                                            (var front-scale 0.0)
                                            (if (>= front-spd-mps SPEED-REGEN-MAX-MPS)
                                                (setq front-scale 1.0)
                                                (if (> front-spd-mps SPEED-REGEN-MIN-MPS)
                                                    (setq front-scale (* (- front-spd-mps SPEED-REGEN-MIN-MPS) INV-REGEN-RANGE))
                                                    (setq front-scale 0.0)
                                                )
                                            )
                                            (setq effective-brake-front (* brake-ratio front-scale))
                                        }
                                    )

                                    ;; With no regen, command 0 current instead of brake mode. In brake mode the VESC applies
                                    ;; current against the sign of the measured speed; near standstill that sign is noise and
                                    ;; can drive the wheel forward (seen on the front wheel).
                                    (if (> effective-brake-rear 0.0)
                                        (set-brake-rel effective-brake-rear)
                                        (set-current 0.0)
                                    )
                                    (if front-vesc-online
                                        (if (> effective-brake-front 0.0)
                                            (canset-brake-rel CAN-ID-FRONT-VESC effective-brake-front)
                                            (canset-current CAN-ID-FRONT-VESC 0.0)
                                        )
                                    )
                                    (setq current-rear-cmd 0.0)
                                    (setq current-front-cmd 0.0)

                                    (if (!= last-log-state 2)
                                        {
                                            (setq last-log-state 2)
                                            (puts "V:Brk")
                                        }
                                    )
                                }
                                {
                                    (setq stop-assist-active nil)
                                    (setq standstill-start-time 0)
                                    (setq actual-brake 0)

                                    ;; Drive
                                    (if (> target-throt THROTTLE-NEUTRAL-COUNTS)
                                        {
                                            ;; Follow the throttle directly. The 2000-count step below was meant for a gap over 35 ms,
                                            ;; but delta-rx is measured after last-rx-time is updated, so it never acts (docs/pitfalls.md).
                                            (if (<= target-throt actual-throt)
                                                (setq actual-throt target-throt)
                                                (if (or (<= delta-rx 0.035) (<= (- target-throt actual-throt) 2000))
                                                    {
                                                        (setq actual-throt target-throt)
                                                        (setq last-log-clamped nil)
                                                    }
                                                    {
                                                        (setq actual-throt (+ actual-throt 2000))
                                                        (if (not last-log-clamped)
                                                            {
                                                                (setq last-log-clamped t)
                                                                (puts "V:ShockAbsorber:+2k")
                                                            }
                                                        )
                                                    }
                                                )
                                            )

                                            (var throt-ratio (/ (to-float actual-throt) 10000.0))
                                            (var rear-throt throt-ratio)
                                            (var front-throt throt-ratio)

                                            ;; Speed limit per wheel: drive fades linearly to 0 over the last 3 mph. Done here, not
                                            ;; on the ESP32, so it keeps working if the ESP32 link fails.
                                            (if (> active-speed-limit 0)
                                                {
                                                    (var lim-mps (/ (to-float active-speed-limit) 100.0))
                                                    (var taper-start (- lim-mps SPEED-LIMIT-TAPER-MPS))

                                                    (var rear-spd-val (get-speed))
                                                    (var rear-spd (if rear-spd-val (abs (to-float rear-spd-val)) 0.0))
                                                    (if (>= rear-spd lim-mps)
                                                        (setq rear-throt 0.0)
                                                        (if (> rear-spd taper-start)
                                                            (setq rear-throt (* throt-ratio (/ (- lim-mps rear-spd) SPEED-LIMIT-TAPER-MPS)))
                                                        )
                                                    )

                                                    (var front-spd-val (if front-vesc-online (canget-speed CAN-ID-FRONT-VESC) 0.0))
                                                    (var front-spd (if front-spd-val (abs (to-float front-spd-val)) 0.0))
                                                    (if (>= front-spd lim-mps)
                                                        (setq front-throt 0.0)
                                                        (if (> front-spd taper-start)
                                                            (setq front-throt (* throt-ratio (/ (- lim-mps front-spd) SPEED-LIMIT-TAPER-MPS)))
                                                        )
                                                    )
                                                }
                                            )

                                            ;; Both motors when dual drive is on and the front is online; otherwise rear only, and the front gets 0 current (not brake mode)
                                            (if (and (= active-dual-mode 1) front-vesc-online)
                                                {
                                                    (set-current-rel rear-throt COAST-OFF-DELAY-SEC)
                                                    (canset-current-rel CAN-ID-FRONT-VESC front-throt COAST-OFF-DELAY-SEC)
                                                    (setq current-rear-cmd rear-throt)
                                                    (setq current-front-cmd front-throt)
                                                }
                                                {
                                                    (set-current-rel rear-throt COAST-OFF-DELAY-SEC)
                                                    (if front-vesc-online
                                                        (canset-current CAN-ID-FRONT-VESC 0.0)
                                                    )
                                                    (setq current-rear-cmd rear-throt)
                                                    (setq current-front-cmd 0.0)
                                                }
                                            )

                                            (if (!= last-log-state 1)
                                                {
                                                    (setq last-log-state 1)
                                                    (if (= active-dual-mode 1)
                                                        (puts "V:Drv:Dual")
                                                        (puts "V:Drv:1WD")
                                                    )
                                                }
                                            )
                                        }
                                        {
                                            ;; Throttle released: 0 current. While rolling, keep modulating for the off-delay so the
                                            ;; next throttle input engages smoothly; the front uses canset-current-rel for the off-delay.
                                            (setq actual-throt 0)
                                            (var rear-rpm-val (get-rpm))
                                            (var rear-rolling (if rear-rpm-val (> (abs (to-float rear-rpm-val)) SPEED-ROLL-THRESH-ERPM) nil))
                                            (if rear-rolling
                                                (set-current 0.0 COAST-OFF-DELAY-SEC)
                                                (set-current 0.0)
                                            )
                                            (if front-vesc-online
                                                (if (= active-dual-mode 1)
                                                    {
                                                        (var front-rpm-val (if front-vesc-online (canget-rpm CAN-ID-FRONT-VESC) 0.0))
                                                        (var front-rpm (if front-rpm-val (to-float front-rpm-val) 0.0))
                                                        (var front-rolling (> (abs front-rpm) SPEED-ROLL-THRESH-ERPM))
                                                        (if front-rolling
                                                            (canset-current-rel CAN-ID-FRONT-VESC 0.0 COAST-OFF-DELAY-SEC)
                                                            (canset-current CAN-ID-FRONT-VESC 0.0)
                                                        )
                                                    }
                                                    (canset-current CAN-ID-FRONT-VESC 0.0)
                                                )
                                            )
                                            (setq current-rear-cmd 0.0)
                                            (setq current-front-cmd 0.0)

                                            (if (!= last-log-state 0)
                                                {
                                                    (setq last-log-state 0)
                                                    (setq last-log-throt 0)
                                                    (setq last-log-brake 0)
                                                    (puts "V:Idle")
                                                }
                                            )
                                        }
                                    )
                                }
                            )
                        }
                    )
                }
            )

            ;; Telemetry, every pass: speed of the faster wheel in cm/s and the fault flags
            (var rear-raw (get-speed))
            (var rear-mps (if rear-raw (abs (to-float rear-raw)) 0.0))
            (var front-raw (if front-vesc-online (canget-speed CAN-ID-FRONT-VESC) 0.0))
            (var front-mps (if front-raw (abs (to-float front-raw)) 0.0))
            (var max-mps (if (> front-mps rear-mps) front-mps rear-mps))
            (var speed-scaled (to-i (round (* max-mps 100.0))))
            (if (> speed-scaled 32767) (setq speed-scaled 32767))
            (if (< speed-scaled -32768) (setq speed-scaled -32768))

            (var can-desync-bit (if front-vesc-online 0 1))
            (var fault-flags (bitwise-or can-desync-bit (shl (get-fault) 1)))
            (bufset-u8 tx-payload 4 fault-flags)
            (bufset-i16 tx-payload 2 speed-scaled 'little-endian)
            (var tx-crc (crc16 tx-payload 5))

            (bufcpy tx-telem 2 tx-payload 0 5)
            (bufset-u16 tx-telem 7 tx-crc)

            (uart-write tx-telem)

            ;; Sleep for the rest of the 20 ms period
            (var elapsed (secs-since t-start))
            (if (< elapsed 0.020)
                (sleep (- 0.020 elapsed))
                (yield 1)
            )
        }
    )
)

;; Front VESC watch, every 100 ms. can-msg-age reads the age of the front's last CAN status message
;; (status 1, sent at the rate set in VESC Tool); after 500 ms it is marked offline.
(defun thd-can-supervisor ()
    (loopwhile t
        {
            (var front-age (can-msg-age CAN-ID-FRONT-VESC 1))
            (if (or (not front-age) (> front-age 0.500))
                {
                    (if front-vesc-online
                        {
                            (atomic (setq front-vesc-online nil))
                            (puts "V:FrontTimeout:E17")
                        }
                    )
                }
                {
                    (if (not front-vesc-online)
                        {
                            (atomic (setq front-vesc-online t))
                            (puts "V:FrontOnline")
                        }
                    )
                }
            )

            (sleep 0.100)
        }
    )
)

@const-end

(spawn thd-powertrain-50hz)
(spawn thd-can-supervisor)
